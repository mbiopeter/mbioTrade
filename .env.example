# Optional: Twelve Data is used first for Gold/forex when this key is supplied.
# BTCUSD uses public Kraken first; Twelve Data provides optional backup snapshots.
# Copy to .env.local for local development, or add to Vercel environment settings.
# Never use NEXT_PUBLIC_ for this secret. Do not commit .env.local.
TWELVE_DATA_API_KEY=

# Public canonical URL for SEO, Open Graph, robots and sitemap.
# Override for your custom domain (no trailing path).
NEXT_PUBLIC_SITE_URL=https://traders.mbiopeter.co.ke

# Google Analytics 4 Measurement ID from the mbioTraders web data stream.
# This is a public identifier, not a credential. Do not paste a Google API secret.
# Set the same GA4 ID as your portfolio if you want a combined property view,
# or use a separate GA4 stream for traders.mbiopeter.co.ke.
NEXT_PUBLIC_GA_ID=

# Optional: use this only while debugging Analytics in localhost.
NEXT_PUBLIC_GA_TRACK_LOCAL=false

# Google Search Console's HTML meta-tag verification content, not a full HTML tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
