FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --include=dev --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
COPY worker ./worker
RUN ./node_modules/.bin/tsc -p worker/tsconfig.json

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/.worker-build ./
COPY --from=build /app/worker/*.json ./worker/
USER node
CMD ["node", "worker/run.js"]
