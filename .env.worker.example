# Copy to .env.worker for local use, or set these as private server environment variables.
# Never use NEXT_PUBLIC_ for an API token. No credentials are required in signals mode.
MBIOTRADE_WORKER_MODE=signals
MBIOTRADE_WORKSPACE_FILE=worker/workspace.example.json

# Set this for a strategy with News Guard enabled. No browser needs to stay open.
# MBIOTRADE_CALENDAR_URL=https://your-app.vercel.app/api/news-calendar

# Required only when MBIOTRADE_WORKER_MODE=automatic.
# DERIV_APP_ID=your_alphanumeric_app_id
# DERIV_API_TOKEN=your_token
# DERIV_ACCOUNT_ID=your_account_id
# DERIV_ACCOUNT_MODE=demo

# Automatic mode additionally requires executionMode=automatic and
# automationExecutor=worker in the exported workspace. Demo and real use the same code.
