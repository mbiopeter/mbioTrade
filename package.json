{
  "name": "mbiotrade",
  "version": "16.0.0",
  "private": true,
  "description": "MbioTrade v16 — verified Next.js App Router startup, preserved Deriv trading and six trend-aligned strategies.",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.mjs",
    "check": "tsc --noEmit",
    "check:config": "node scripts/check-config.mjs && node scripts/check-app-router.mjs && node scripts/check-maintainability.mjs && node scripts/check-imports.mjs",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run check:config && npm run check && npm test",
    "quality": "npm run format:check && npm run verify",
    "build:ready": "npm run quality && npm run build",
    "worker": "node --env-file-if-exists=.env.worker --import tsx worker/run.ts",
    "worker:check": "node --env-file-if-exists=.env.worker --import tsx worker/run.ts --check",
    "worker:build": "tsc -p worker/tsconfig.json",
    "predev": "node scripts/prepare-next.mjs",
    "predev:turbo": "node scripts/prepare-next.mjs",
    "prebuild": "node scripts/prepare-next.mjs",
    "doctor": "node scripts/prepare-next.mjs --check",
    "dev:clean": "node scripts/clear-next-cache.mjs && npm run dev",
    "smoke:dev": "node scripts/smoke-next.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "lightweight-charts": "^5.0.8",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
